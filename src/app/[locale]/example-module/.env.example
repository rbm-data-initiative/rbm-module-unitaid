# Copy to the sandbox root as .env.local (never commit real values).
# Every variable of this module is prefixed with EXAMPLE_MODULE_.

# Published CSV of the external source (e.g. Google Sheets "Publish to web" link:
# https://docs.google.com/spreadsheets/d/e/<id>/pub?gid=<gid>&single=true&output=csv).
# Leave empty to use the bundled sample in public/example-module/sample.csv.
EXAMPLE_MODULE_SOURCE_URL=

# Shared secret the notification sender must send as "Authorization: Bearer <token>".
EXAMPLE_MODULE_NOTIFICATIONS_TOKEN=change-me

# Server-side cache lifetime for the external fetch, in seconds (default 300).
EXAMPLE_MODULE_REVALIDATE_SECONDS=300
