# Copy to the sandbox root as .env.local (never commit real values).
# Every variable of this module is prefixed with UNITAID_. None is NEXT_PUBLIC_:
# all four are read on the server only (lib/env.ts), so no value reaches the browser.
# The real values are sent to the internal team privately.

# Address of the published dataset, with {locale} where the language goes.
# Optional: when empty, the module reads the published address it names itself
# (lib/data.ts). Set it only to point at another copy of the dataset.
UNITAID_DATA_URL=

# Shared secret the LAUNCH pipeline sends to POST /api/unitaid/notifications as
# "Authorization: Bearer <token>". Required in production: when empty, the
# route refuses every notification (503). Read on every request (no rebuild).
UNITAID_NOTIFICATIONS_TOKEN=change-me

# The LAUNCH forms service behind Subscribe, Send feedback and Unsubscribe:
# its base address (https, no trailing slash) and the token this site's server
# sends it (at least 32 characters). When either is missing or invalid,
# Subscribe is hidden, Send feedback is not connected, and the three relays
# answer 503. The page checks them whenever it is rendered (at build, then at
# each 5-minute refresh), so set them before the build; the relays read them on
# every request.
UNITAID_FORMS_URL=
UNITAID_FORMS_TOKEN=
